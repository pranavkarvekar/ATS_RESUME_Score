# ============================================================
# ATS Resume Analyzer v2 — Production Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ============================================================

# ── LLM (Groq) ───────────────────────────────────────────────
GROQ_API_KEY=gsk_your_real_groq_key_here
GROQ_MODEL=groq/compound
GROQ_FALLBACK_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Security ─────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=change-this-to-a-strong-random-key

# ── Database ─────────────────────────────────────────────────
# SQLite (default — fine for single-instance deployments)
DATABASE_URL=sqlite+aiosqlite:////app/data/ats_data.db

# PostgreSQL alternative (remove the line above, uncomment below)
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/ats_v2

# ── Scoring Weights (must sum to 100) ────────────────────────
DEFAULT_SKILL_WEIGHT=35
DEFAULT_EXPERIENCE_WEIGHT=25
DEFAULT_CONTEXT_WEIGHT=40

# ── Cache ────────────────────────────────────────────────────
RESUME_CACHE_TTL_DAYS=7

# ── Embedding Model Cache ─────────────────────────────────────
# Where to store the downloaded all-MiniLM-L6-v2 model (~90MB)
TRANSFORMERS_CACHE=/app/data/model_cache
HF_HOME=/app/data/model_cache

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20
