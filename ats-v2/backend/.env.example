# === LLM ===
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# === Database ===
# Local development (SQLite — zero config):
DATABASE_URL=sqlite+aiosqlite:///./ats_data.db
# Production (PostgreSQL — uncomment and fill):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ats

# === Security ===
API_KEY=dev-api-key-change-in-production
CORS_ORIGINS=http://localhost:8000,http://localhost:5500,http://127.0.0.1:8000

# === Limits ===
MAX_FILE_SIZE_MB=10
OCR_CHAR_THRESHOLD=150
RATE_LIMIT=30/minute

# === Scoring Defaults (stored in DB, these are initial seed values) ===
DEFAULT_SKILL_WEIGHT=35
DEFAULT_EXPERIENCE_WEIGHT=25
DEFAULT_CONTEXT_WEIGHT=40
EXPERIENCE_TARGET_MONTHS=36

# === System Paths (Windows only — Docker handles these automatically) ===
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler\Library\bin
